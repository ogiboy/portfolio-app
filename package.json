{
  "name": "portfolio-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "releasePolicy": {
    "bootstrapVersion": "0.2.0",
    "conventionalCommitBaseline": "3b72500dc4ce82ba6ef22a86d51479f69da12e96",
    "conventionalCommitExceptions": [
      {
        "sha": "56ecae78955bb6d0ee370e50122360f88080c040",
        "reason": "Legacy CircleCI setup commit merged through PR #17."
      },
      {
        "sha": "4623479d40758cee7a0107981b538d7c86d32f16",
        "reason": "CodeRabbit documentation commit requested through PR #31."
      }
    ]
  },
  "scripts": {
    "dev": "nx next:dev portfolio-app --turbopack",
    "build": "nx next:build portfolio-app --webpack",
    "build:turbopack": "nx next:build portfolio-app",
    "start": "nx next:start portfolio-app",
    "lint": "eslint .",
    "qa:bundle-budget": "node scripts/qa/bundle-budget.mjs",
    "qa:docstrings": "node scripts/qa/docstring-coverage.mjs --enforce-threshold",
    "qa:docstrings:report": "node scripts/qa/docstring-coverage.mjs",
    "qa:modularity": "node scripts/qa/modularity-gate.mjs --fail-on-findings",
    "qa:modularity:report": "node scripts/qa/modularity-gate.mjs",
    "qa:typescript": "node scripts/qa/typescript-toolchain.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "tsc6 --noEmit",
    "test": "nx vitest:test portfolio-app -- run",
    "test:coverage": "nx vitest:test portfolio-app -- run --coverage",
    "test:watch": "nx vitest:test portfolio-app",
    "test:e2e": "nx e2e portfolio-app",
    "browser:setup": "playwright install --with-deps chromium",
    "audit": "pnpm audit --prod --audit-level high",
    "release:plan": "node scripts/release/release-state.ts",
    "release:check": "node scripts/release/release-state.ts --check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ci": "pnpm format:check && pnpm lint && pnpm qa:typescript && pnpm qa:docstrings && pnpm qa:modularity && pnpm typecheck && pnpm typecheck:compat && pnpm release:check && pnpm test:coverage && pnpm test:e2e && pnpm build && pnpm qa:bundle-budget && pnpm run audit",
    "sonar": "pnpm sonar:local",
    "sonar:start": "scripts/sonarqube/start-local.sh",
    "sonar:status": "scripts/sonarqube/status-local.sh",
    "sonar:stop": "scripts/sonarqube/stop-local.sh",
    "sonar:local": "scripts/qa/run_sonar_scan.sh"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
